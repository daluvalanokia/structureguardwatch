@* Views/Shared/_Layout.cshtml — StructureWatch Dark Theme *@
<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css" />
    <link rel="stylesheet" href="~/css/structurewatch.css" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>tailwind.config = { darkMode: 'class' }</script>
    <style>
        #map { background: #1a1a2e; }
        .leaflet-container { background: #1a1a2e; }
        .leaflet-tooltip { background: #111827; border: 1px solid #374151; color: #f3f4f6; }
        .leaflet-popup-content-wrapper { background: #111827; color: #f3f4f6; }
    </style>
</head>
<body class="bg-gray-950 text-gray-100">
    @RenderBody()
    @RenderSection("Scripts", required: false)
</body>
</html>
