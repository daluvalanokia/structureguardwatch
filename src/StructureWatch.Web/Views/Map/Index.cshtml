@* Views/Map/Index.cshtml — StructureWatch Real-Map Mode *@
@{
    ViewData["Title"] = "StructureWatch — Real-Map Mode";
}

<div class="flex h-screen bg-gray-950 text-gray-100 overflow-hidden">
    @* Left: Map + Top Bar + Status Bar *@
    <div class="flex-1 flex flex-col">
        @* Top Bar *@
        <div class="h-12 bg-gray-900 border-b border-gray-800 flex items-center px-4 gap-4 relative z-[1000]">
            <span class="font-bold text-teal-400 text-lg whitespace-nowrap">StructureWatch</span>
            <span class="text-gray-500 text-sm whitespace-nowrap">Real-Map Mode</span>
            <div class="ml-auto relative flex gap-2 items-center">
                <div class="relative">
                    <input id="searchBox" type="text" placeholder="Search city, state..."
                           class="bg-gray-800 text-sm px-3 py-1.5 rounded border border-gray-700 focus:border-teal-500 outline-none w-[400px] pr-8"
                           autocomplete="off" />
                    <span id="searchClear" class="absolute right-2 top-1/2 -translate-y-1/2 text-gray-500 hover:text-gray-300 cursor-pointer hidden">✕</span>
                    <div id="searchSpinner" class="absolute right-8 top-1/2 -translate-y-1/2 hidden">
                        <span class="inline-block w-3 h-3 border-2 border-teal-500 border-t-transparent rounded-full animate-spin"></span>
                    </div>
                </div>
                <div id="searchDropdown" class="absolute top-full mt-1 right-0 w-[400px] bg-gray-900 border border-gray-700 rounded-lg shadow-xl max-h-80 overflow-auto hidden z-[1001]"></div>
            </div>
        </div>

        @* Map Container *@
        <div class="flex-1 relative">
            <div id="map" class="absolute inset-0 z-0"></div>

            @* Scan Overlay *@
            <div id="scanOverlay" class="absolute inset-0 z-[500] pointer-events-none hidden flex items-center justify-center bg-gray-950/30">
                <div class="scan-radar relative w-96 h-96 rounded-full border-2 border-teal-500/50">
                    <div class="scan-sweep absolute inset-0 rounded-full"></div>
                    <div class="absolute inset-0 flex items-center justify-center">
                        <span id="scanLabel" class="text-teal-400 font-semibold text-lg bg-gray-950/80 px-4 py-2 rounded-lg">Scanning...</span>
                    </div>
                </div>
            </div>

            @* Tooltip *@
            <div id="tooltip" class="absolute z-[600] bg-gray-900 border border-gray-700 rounded-lg p-2 text-sm shadow-xl pointer-events-none hidden max-w-xs"></div>

            @* Loading *@
            <div id="loading" class="absolute top-4 left-1/2 -translate-x-1/2 z-[600] bg-gray-900 border border-teal-500 px-4 py-2 rounded-full text-sm hidden">
                <span class="inline-block animate-spin mr-2">⟳</span> Fetching buildings...
            </div>

            @* Toast *@
            <div id="toast" class="absolute bottom-4 left-1/2 -translate-x-1/2 z-[600] bg-red-900 border border-red-500 px-4 py-2 rounded-full text-sm hidden"></div>
        </div>

        @* Status Bar *@
        <div class="h-8 bg-gray-900 border-t border-gray-800 flex items-center px-4 text-xs text-gray-400 gap-6">
            <span id="cursorCoords">Lat: --, Lng: --</span>
            <span id="zoomLevel">Zoom: 15</span>
            <span id="buildingCount">Buildings: 0</span>
            <span id="currentLocationLabel" class="ml-auto text-teal-400"></span>
        </div>
    </div>

    @* Right: Inspector Sidebar *@
    <div class="w-[350px] bg-gray-900 border-l border-gray-800 flex flex-col">
        <div class="h-12 border-b border-gray-800 flex items-center px-4">
            <span class="font-semibold">Inspector</span>
            <button id="dragBtn" class="ml-auto bg-gray-700 hover:bg-gray-600 px-3 py-1 rounded text-xs font-medium">✋ Drag Mode</button>
        </div>
        <div id="inspector" class="flex-1 overflow-auto p-4 hidden">
            <p class="text-gray-500 text-sm">Click a building to inspect.</p>
        </div>
        <div id="collisionPanel" class="border-t border-gray-800 p-4 max-h-48 overflow-auto">
            <p class="text-gray-500 text-sm">Enable drag mode and drag from a selected building to check collisions.</p>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/leaflet/leaflet.min.js"></script>
    <script src="~/lib/three/three.min.js"></script>
    <script src="~/js/leaflet-three-layer.js"></script>
    <script src="~/js/structurewatch.js"></script>
    <script src="~/js/collision.js"></script>
}
